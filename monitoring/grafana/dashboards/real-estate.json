{
  "title": "Real Estate Prediction API",
  "uid": "real-estate-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Predictions per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(predictions_total[5m])", "legendFormat": "predictions/s", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Prediction failures per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(prediction_errors_total[5m])", "legendFormat": "failures/s", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Prediction latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(prediction_latency_seconds_bucket[5m])))", "legendFormat": "p95 seconds", "refId": "A" }
      ]
    }
  ]
}
